<Window x:Class="ByteGuard.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Richiesta Chiave di Sicurezza" Height="250" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#1A1A2E" FontFamily="Segoe UI" ShowInTaskbar="False">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="🔒 Autenticazione C++" Foreground="#00D4FF" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="Inserisci la chiave crittografica per l'operazione (XOR/FNV-1a)." Foreground="#8892A4" TextWrapping="Wrap"/>
        </StackPanel>
        
        <PasswordBox Grid.Row="1" x:Name="TxtPassword" VerticalAlignment="Center" Height="35" FontSize="16" Background="#16213E" Foreground="#E8EAF0" BorderBrush="#0F3460" BorderThickness="1" Padding="5"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Annulla" Width="90" Height="35" Margin="0,0,10,0" Background="Transparent" Foreground="#8892A4" BorderThickness="0" Click="BtnCancel_Click" Cursor="Hand"/>
            <Button x:Name="BtnConfirm" Content="Conferma" Width="100" Height="35" Background="#00D4FF" Foreground="#1A1A2E" FontWeight="Bold" BorderThickness="0" Click="BtnConfirm_Click" Cursor="Hand" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
