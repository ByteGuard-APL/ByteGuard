<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <!-- CS4014: fire-and-forget intentionale per StartWatchdogAsync (watchdog a vita indefinita) -->
    <NoWarn>$(NoWarn);CS4014</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Copia analyzer.py nella cartella di output della build accanto all'eseguibile.
      Percorso sorgente : ..\Python\analyzer.py  (relativo a ByteGuard.csproj)
      Percorso destinaz.: bin\Debug\net8.0-windows\Python\analyzer.py
      PreserveNewest    : copia solo se il file sorgente è più recente, evitando
                          ricompilazioni inutili ad ogni build.
      Link              : definisce il percorso virtuale nel progetto VS Code.
    -->
    <Content Include="..\Python\analyzer.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Python\analyzer.py</Link>
    </Content>
    <Resource Include="AppIcon.ico" />
  </ItemGroup>

  <!--
    Pre-build automatico del modulo C++.
    L'exe viene prodotto in core-cpp/build/ByteGuardCrypto.exe.
  -->
  <PropertyGroup>
    <GppPath Condition="Exists('C:\msys64\ucrt64\bin\g++.exe')">"C:\msys64\ucrt64\bin\g++.exe"</GppPath>
    <GppPath Condition="'$(GppPath)' == ''">g++</GppPath>
  </PropertyGroup>

  <Target Name="BuildCppCrypto" BeforeTargets="BuildGoWatchdog">
    <MakeDir Directories="..\core-cpp\build" Condition="!Exists('..\core-cpp\build')" />
    <Message Text="--- ByteGuard: compilazione modulo C++ con g++... ---" Importance="high" />
    <Exec Command="$(GppPath) -std=c++20 -O2 ..\core-cpp\src\main.cpp ..\core-cpp\src\ByteGuardCrypto.cpp -I..\core-cpp\include -I..\core-cpp\third_party -o ..\core-cpp\build\ByteGuardCrypto.exe"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          ContinueOnError="true" />
    <!-- Copia l'exe nella cartella di output (bin/Debug) -->
    <Copy SourceFiles="..\core-cpp\build\ByteGuardCrypto.exe" DestinationFolder="$(OutDir)" ContinueOnError="true" />
    <Message Text="--- ByteGuard: ByteGuardCrypto.exe pronto. ---" Importance="high" />
  </Target>

  <!--
    Pre-build automatico del modulo Go.
    Evita di buildare manualmente il watchdog Go prima di compilare ByteGuard.
  -->
  <Target Name="BuildGoWatchdog" BeforeTargets="Build">
    <Message Text="--- ByteGuard: compilazione watchdog Go in corso... ---" Importance="high" />
    <Exec Command="go build -o watchdog.exe ."
          WorkingDirectory="..\watchdog-go"
          ConsoleToMSBuild="true" />
    <!-- Copia l'exe nella cartella di output (bin/Debug) -->
    <Copy SourceFiles="..\watchdog-go\watchdog.exe" DestinationFolder="$(OutDir)" />
    <Message Text="--- ByteGuard: watchdog.exe pronto. ---" Importance="high" />
  </Target>

</Project>
