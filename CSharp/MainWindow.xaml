<Window x:Class="ByteGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ByteGuard"
        Title="ByteGuard — Forensic File Analyzer"
        Height="700"
        Width="950"
        MinHeight="650"
        MinWidth="800"
        Background="#1A1A2E"
        FontFamily="Segoe UI"
        Icon="AppIcon.ico">
    <!-- Risorse di stile per i bottoni di navigazione -->
    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8892A4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A2A4A"/>
                                <Setter Property="Foreground" Value="#E8EAF0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#0F3460"/>
                                <Setter Property="Foreground" Value="#00D4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#1E1E24" Padding="15">
            <StackPanel>
                <!-- Header (Hamburger + Logo) -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,40">
                    <!-- Hamburger Button -->
                    <Button Content="☰" FontSize="20" Foreground="#8892A4" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnToggleSidebar_Click" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    
                    <!-- Logo -->
                    <StackPanel x:Name="LogoPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️" FontSize="32" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ByteGuard" Foreground="#00D4FF" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="Forensics &amp; Crypto" Foreground="#8892A4" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                
                <TextBlock x:Name="TxtModuli" Text="MODULI" Foreground="#8892A4" FontSize="11" FontWeight="Bold" Margin="10,0,0,10"/>
                
                <RadioButton x:Name="NavAnalysis" Style="{StaticResource NavButtonStyle}" IsChecked="True" Click="NavAnalysis_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="16" Width="25" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtNavAnalysis" Text="Analisi &amp; Monitoraggio" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </RadioButton>
                             
                <RadioButton x:Name="NavCrypto" Style="{StaticResource NavButtonStyle}" Click="NavCrypto_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔐" FontSize="16" Width="25" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtNavCrypto" Text="Cassaforte Criptata" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- FRAME PRINCIPALE: sfondo trasparente per evitare il bianco di default di WPF -->
        <Frame Grid.Column="1" x:Name="MainFrame" NavigationUIVisibility="Hidden" Background="#1A1A2E">
            <Frame.Resources>
                <!-- Rimuove il bordo bianco che WPF aggiunge attorno alle pagine nel Frame -->
                <Style TargetType="Frame">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Frame">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Frame.Resources>
        </Frame>
    </Grid>
</Window>
