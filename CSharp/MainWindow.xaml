<Window x:Class="ByteGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ByteGuard"
        Title="ByteGuard — Forensic File Analyzer"
        Height="700"
        Width="950"
        MinHeight="650"
        MinWidth="800"
        Background="#1A1A2E"
        FontFamily="Segoe UI"
        Icon="AppIcon.ico">

    <Window.Resources>
        <local:FileSizeConverter x:Key="FileSizeConverter" />
        <local:FileNameConverter x:Key="FileNameConverter" />
        <local:StatusConverter x:Key="StatusConverter" />

        <SolidColorBrush x:Key="BgPrimary"    Color="#1A1A2E"/>
        <SolidColorBrush x:Key="BgSecondary"  Color="#16213E"/>
        <SolidColorBrush x:Key="BgCard"       Color="#0F3460"/>
        <SolidColorBrush x:Key="AccentCyan"   Color="#00D4FF"/>
        <SolidColorBrush x:Key="TextPrimary"  Color="#E8EAF0"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#8892A4"/>
        <SolidColorBrush x:Key="ColorOk"      Color="#2ECC71"/>
        <SolidColorBrush x:Key="ColorWarn"    Color="#F39C12"/>
        <SolidColorBrush x:Key="ColorDanger"  Color="#E74C3C"/>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,10,0,2"/>
        </Style>

        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize"    Value="15"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background"  Value="{StaticResource AccentCyan}"/>
            <Setter Property="Foreground"  Value="{StaticResource BgPrimary}"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Padding"     Value="15,8"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33E8FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#009ABF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#3A3A5C"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#2A2A4A"/>
            <Setter Property="Margin"     Value="0,15,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header -->
            <RowDefinition Height="*"/>      <!-- Content (Master-Details) -->
            <RowDefinition Height="Auto"/>   <!-- Status Bar / Progress -->
        </Grid.RowDefinitions>

        <!-- ROW 0: HEADER -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondary}" Padding="25,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#x1F6E1;" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="ByteGuard" Foreground="{StaticResource AccentCyan}" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Forensic File Analyzer — APL University Project" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ROW 1: MASTER-DETAILS CONTENT -->
        <Grid Grid.Row="1" Margin="20,15,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>      <!-- Left: File List -->
                <ColumnDefinition Width="420"/>    <!-- Right: Details -->
            </Grid.ColumnDefinitions>

            <!-- SINISTRA: Lista File (Master) -->
            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Drop Zone / Buttons -->
                    <RowDefinition Height="*"/>    <!-- DataGrid -->
                </Grid.RowDefinitions>
                
                <!-- Drop Zone Compatta -->
                <Border Grid.Row="0" Margin="0,0,0,15" Background="#0D1B2A" CornerRadius="8" BorderThickness="2" BorderBrush="{StaticResource BgCard}" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" x:Name="DropZoneBorder">
                    <StackPanel Margin="15" Orientation="Vertical">
                        <TextBlock x:Name="TxtDropPrompt" Text="Trascina file o cartelle qui" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button x:Name="BtnBrowseFile" Content="Sfoglia File..." Style="{StaticResource PrimaryButtonStyle}" Click="BtnBrowseFile_Click" Margin="0,0,10,0"/>
                            <Button x:Name="BtnBrowseFolder" Content="Sfoglia Cartella..." Style="{StaticResource PrimaryButtonStyle}" Click="BtnBrowseFolder_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- DataGrid Lista File -->
                <DataGrid Grid.Row="1" x:Name="FilesDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" Background="{StaticResource BgSecondary}" RowBackground="#16213E" AlternatingRowBackground="#1A1A2E" Foreground="{StaticResource TextPrimary}" GridLinesVisibility="None" BorderThickness="0" SelectionChanged="FilesDataGrid_SelectionChanged">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#0F3460"/>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2A2A4A"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentCyan}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Trigger>
                                <!-- Anomalie Forensi (Arancione) -->
                                <DataTrigger Binding="{Binding IsAnomalous}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ColorWarn}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <!-- Errori di Analisi (Rosso) -->
                                <DataTrigger Binding="{Binding AnomalyCode}" Value="ANALYSIS_ERROR">
                                    <Setter Property="Foreground" Value="{StaticResource ColorDanger}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <!-- I converter servono a trasformare i valori del DTO in formati adatti per la visualizzazione -->
                        <DataGridTextColumn Header="Nome File" Binding="{Binding FilePath, Converter={StaticResource FileNameConverter}}" Width="*" />
                        <DataGridTextColumn Header="Dimensione" Binding="{Binding FileSizeBytes, Converter={StaticResource FileSizeConverter}}" Width="80" />
                        <DataGridTextColumn Header="H" Binding="{Binding ShannonEntropy, StringFormat={}{0:F2}}" Width="50" />
                        <DataGridTextColumn Header="Verdetto" Binding="{Binding Verdict}" Width="250" />
                        <DataGridTextColumn Header="Stato" Binding="{Binding AnalysisStatus, Converter={StaticResource StatusConverter}}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- DESTRA: Dettagli (Details) -->
            <Border Grid.Column="1" Background="{StaticResource BgSecondary}" CornerRadius="12" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Intestazione del pannello output -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="&#x25BA;" Foreground="{StaticResource AccentCyan}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="DETTAGLIO FILE" Foreground="{StaticResource AccentCyan}" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>

                        <Separator/>

                        <!-- CAMPO: Stato analisi -->
                        <TextBlock Style="{StaticResource LabelStyle}" Text="STATO"/>
                        <TextBlock x:Name="TxtStatus" Style="{StaticResource ValueStyle}" Text="Seleziona un file dalla lista..."/>

                        <!-- Percorso file analizzato -->
                        <TextBlock Style="{StaticResource LabelStyle}" Text="PERCORSO FILE"/>
                        <TextBlock x:Name="TxtFilePath" Style="{StaticResource ValueStyle}" Text="&#x2014;" TextWrapping="Wrap"/>

                        <!-- Dimensione file -->
                        <TextBlock Style="{StaticResource LabelStyle}" Text="DIMENSIONE"/>
                        <TextBlock x:Name="TxtFileSize" Style="{StaticResource ValueStyle}" Text="&#x2014;"/>

                        <Separator/>

                        <!-- CAMPO CRITICO: Entropia di Shannon -->
                        <TextBlock Style="{StaticResource LabelStyle}" Text="ENTROPIA DI SHANNON"/>
                        <TextBlock x:Name="TxtEntropy" Style="{StaticResource ValueStyle}" Text="&#x2014;"/>
                        <!-- Barra visiva dell'entropia -->
                        <Grid Margin="0,5,0,0" x:Name="EntropyBarContainer">
                            <Border Height="8" Background="#2A2A4A" CornerRadius="4"/>
                            <Border x:Name="EntropyBarFill" Height="8" Background="{StaticResource AccentCyan}" CornerRadius="4" HorizontalAlignment="Left" Width="0"/>
                        </Grid>

                        <Separator/>

                        <!-- CAMPO CRITICO: Sanity Check -->
                        <TextBlock Style="{StaticResource LabelStyle}" Text="SANITY CHECK (MAGIC BYTES)"/>
                        <TextBlock x:Name="TxtSanityCheck" Style="{StaticResource ValueStyle}" Text="&#x2014;"/>

                        <!-- Magic Number (HEX) -->
                        <TextBlock Style="{StaticResource LabelStyle}" Text="MAGIC NUMBER (HEX)"/>
                        <TextBlock x:Name="TxtMagicHex" Style="{StaticResource ValueStyle}" Text="&#x2014;"/>

                        <!-- Magic Number (ASCII) -->
                        <TextBlock Style="{StaticResource LabelStyle}" Text="MAGIC NUMBER (ASCII)"/>
                        <TextBlock x:Name="TxtMagicAscii" Style="{StaticResource ValueStyle}" Text="&#x2014;"/>

                        <Separator/>

                        <!-- Timestamp -->
                        <TextBlock Style="{StaticResource LabelStyle}" Text="TIMESTAMP UTC"/>
                        <TextBlock x:Name="TxtTimestamp" Style="{StaticResource ValueStyle}" Text="&#x2014;" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ROW 2: STATUS BAR -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondary}" Padding="25,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="TxtGlobalStatus" Grid.Column="0" Text="Pronto" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                
                <ProgressBar x:Name="GlobalProgressBar" Grid.Column="1" Margin="20,0" Height="8" Minimum="0" Maximum="100" Value="0" Background="#2A2A4A" Foreground="{StaticResource AccentCyan}" BorderThickness="0" VerticalAlignment="Center"/>
                
                <TextBlock x:Name="TxtAnomalyCount" Grid.Column="2" Text="Anomalie: 0" Foreground="{StaticResource ColorWarn}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
